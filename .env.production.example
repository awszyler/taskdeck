# ─────────────────────────────────────────────────────────────────────────────
# Taskdeck — Production environment
# Copy to .env.production and fill every CHANGEME / placeholder value.
# This file is NOT gitignored by design (it's the example); the real
# .env.production IS gitignored.
# ─────────────────────────────────────────────────────────────────────────────

# ── Public hostname (used by Caddy TLS + CORS + WeCom callback URL) ──────────
# Set to your real domain, e.g. taskdeck.example.com
# For IP-only HTTP: set to the bare IP address and update ws:// / http:// below.
PUBLIC_HOSTNAME=taskdeck.example.com

# ── Database ─────────────────────────────────────────────────────────────────
# Password must match POSTGRES_PASSWORD below. CHANGEME.
DATABASE_URL=postgresql+asyncpg://taskdeck:CHANGEME@postgres:5432/taskdeck

# Must match DATABASE_URL password above. CHANGEME.
POSTGRES_PASSWORD=CHANGEME

# ── Runner auth token ─────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
# The SAME value must go into .env.runner as TD_RUNNER_TOKEN.
TD_RUNNER_BEARER_TOKEN=CHANGEME_openssl_rand_hex_32

# ── CORS (browser → API) ──────────────────────────────────────────────────────
# Caddy serves the SPA from the same origin, so CORS is only needed if you
# access the API from a different origin. Leave empty to disable CORS headers.
CORS_ORIGINS=https://taskdeck.example.com

# ── Public base URL (used in WeCom notification links) ───────────────────────
# Must match PUBLIC_HOSTNAME scheme and host.
TD_PUBLIC_BASE_URL=https://taskdeck.example.com

# ── Artifacts ────────────────────────────────────────────────────────────────
TD_ARTIFACT_DIR=/var/taskdeck/artifacts

# ── LiteLLM (intent parser) ───────────────────────────────────────────────────
# Point at your LiteLLM proxy or any OpenAI-compatible endpoint.
TD_LITELLM_BASE_URL=https://your-litellm-proxy.example.com
TD_LITELLM_API_KEY=CHANGEME
TD_INTENT_PARSER_MODEL=qwen3-coder-30b

# ── WeCom (企业微信) ──────────────────────────────────────────────────────────
# Set TD_WECOM_ENABLED=false until you have completed the WeCom setup steps
# in docs/tier3-deployment.md. Then flip to true and restart core.
TD_WECOM_ENABLED=false

# Corp ID — from 企业微信管理后台 → 我的企业 → 企业ID (corpid)
TD_WECOM_CORP_ID=CHANGEME

# Self-built app credentials — from 应用管理 → 自建 → your app
TD_WECOM_AGENT_ID=CHANGEME
TD_WECOM_SECRET=CHANGEME

# Message-receive credentials — set when configuring 接收消息 in the app settings.
# Generate Token: any printable string you choose (keep it secret).
# AES key: 43 Base64 characters (use WeCom's "随机生成" button or generate yourself).
TD_WECOM_TOKEN=CHANGEME
TD_WECOM_AES_KEY=CHANGEME

# Workspace slug that incoming WeCom DMs are routed to by default.
# Create this workspace in the UI first, then paste its slug here.
TD_WECOM_DEFAULT_WORKSPACE_SLUG=default

# ── Auth (P5.1) — Cognito-backed BFF + MFA ──────────────────────────────────
# Default `disabled` keeps the original single-user behaviour. Switch to
# `cognito` once you have created a User Pool (see docs/runbook.md §10).
TD_AUTH_MODE=disabled

# Following block only takes effect when TD_AUTH_MODE=cognito.
# TD_AUTH_ALLOW_SIGNUP=false                       # true exposes /signup UI + endpoint
# TD_COGNITO_USER_POOL_ID=ap-northeast-1_xxxxxxxxx
# TD_COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxx   # public app client (no secret)
# TD_COGNITO_REGION=ap-northeast-1

# Fernet key encrypts Cognito refresh + access tokens at rest in user_sessions.
# Generate: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# TD_SESSION_ENCRYPTION_KEY=
# TD_SESSION_COOKIE_NAME=ccpt_session
# TD_SESSION_COOKIE_DOMAIN=                        # leave empty for host-only cookie

# ── Grafana admin password ───────────────────────────────────────────────────
# Required to start the grafana service. Operator logs in as user "admin"
# at http://localhost:3001 (reached via SSH local-forward — never public).
GRAFANA_ADMIN_PASSWORD=CHANGEME_pick_a_strong_password
