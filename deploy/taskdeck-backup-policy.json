{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AllowBackupBucketWrite",
      "Effect": "Allow",
      "Action": [
        "s3:PutObject",
        "s3:PutObjectAcl"
      ],
      "Resource": "arn:aws:s3:::<backup-bucket>/*"
    },
    {
      "Sid": "AllowBackupBucketList",
      "Effect": "Allow",
      "Action": ["s3:ListBucket"],
      "Resource": "arn:aws:s3:::<backup-bucket>"
    }
  ]
}
