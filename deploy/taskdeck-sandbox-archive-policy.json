{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ArchiveBucketReadWrite",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:PutObject",
        "s3:DeleteObject"
      ],
      "Resource": "arn:aws:s3:::<data-bucket>/archive/*"
    },
    {
      "Sid": "ArchiveBucketList",
      "Effect": "Allow",
      "Action": ["s3:ListBucket"],
      "Resource": "arn:aws:s3:::<data-bucket>",
      "Condition": {
        "StringLike": {
          "s3:prefix": ["archive/*", "archive"]
        }
      }
    }
  ]
}
