# ─────────────────────────────────────────────────────────────────────────────
# Taskdeck Runner — environment file
# Copy to /opt/taskdeck/.env.runner on the server and fill values.
# ─────────────────────────────────────────────────────────────────────────────

# WebSocket endpoint for the runner to connect to core.
# Use wss:// when core is behind Caddy TLS (recommended).
TD_CORE_WS_URL=wss://taskdeck.example.com/api/v1/crp/connect

# HTTP base URL for runner → core REST calls.
TD_CORE_HTTP_URL=https://taskdeck.example.com

# Must match TD_RUNNER_BEARER_TOKEN in .env.production (same openssl token).
TD_RUNNER_TOKEN=CHANGEME_same_as_RUNNER_BEARER_TOKEN

# Human-readable name shown in the UI runner list.
TD_RUNNER_NAME=prod-runner

# How many tasks to run concurrently.
TD_MAX_PARALLEL=4

# Directory where the runner clones repos / creates worktrees.
TD_WORK_DIR=/var/taskdeck/work

# Path to the claude-code CLI binary if installed on this host.
# Comment out if not available; the runner will degrade gracefully.
# TD_CLAUDE_CODE_BIN=/usr/local/bin/claude
