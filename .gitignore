# ---------- 9. 数据库 / 数据 ----------
*.db
*.db-journal
*.sqlite
*.sqlite3
*.rdb
*.dump
*.sql.gz
data/
!data/.gitkeep
uploads/
workspace/
sandbox/
tmp/
temp/

# ---------- 10. 编辑器 / 系统 ----------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
desktop.ini
.vscode/
!.vscode/extensions.json
.idea/
*.swp
*.swo
*~
.history/
*.bak
*.orig
*.rej
