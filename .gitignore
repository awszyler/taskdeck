# ============================================================
# 开源前 .gitignore 基线 —— 三个新仓库通用
# 原则：先 deny 一切高危形态，再按需 ! 白名单放行少数示例文件
# ============================================================

# ---------- 1. 环境变量 / 配置（红线）----------
.env
.env.*
!.env.example
!.env.*.example
*.env
.envrc
.direnv/
env.sh
setenv.sh
secrets.*
config.local.*
*.local.json
!*.example.json
appsettings.*.json
!appsettings.Example.json

# 项目自有的真实配置（只发 .example）—— 按项目调整这一段，别照抄
# 判断标准：文件里会不会被填入真实密钥/端点。会 → 屏蔽并提供 .example；不会 → 不要屏蔽。
config/model.json
!config/*.example
!config/*.example.json

# ---------- 2. 凭证 / 密钥（红线）----------
*.pem
*.key
!**/*public*.key
*.p12
*.pfx
*.jks
*.keystore
*.crt
*.cer
*.der
*.asc
*.gpg
id_rsa*
id_ed25519*
id_ecdsa*
*.ppk
.netrc
.npmrc
.pypirc
pip.conf
.docker/
docker/config.json
.aws/
credentials
kubeconfig*
.kube/
*_rsa
*_dsa
authorized_keys
known_hosts

# ---------- 3. 日志（红线）----------
*.log
*.log.*
logs/
log/
nohup.out
*.out
!*.stdout.example
npm-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
*.pid
*.seed
*.pid.lock
# core dump：必须锚定根目录 + 限定数字后缀，否则 `core` 会吞掉 src/core/ 这类源码目录，
# `core.*` 会吞掉 core.py。这是实测踩到的坑。
/core
core.[0-9]*
crash-*.txt
*.dmp

# ---------- 4. 测试记录 / 运行痕迹（红线）----------
# 只匹配带时间戳的生成物；不要写 manual_test_* ——
# macOS 上 core.ignorecase=true，它会连 MANUAL_TEST_MODE.md 这类文档一起吞掉。
manual_test_[0-9]*
manual_test_*.log
optimization_prompt_[0-9]*
*_test_*.log
test-results/
test-output/
test_output/
playwright-report/
blob-report/
.pytest_cache/
.ruff_cache/
.tox/
.nox/
htmlcov/
.coverage
.coverage.*
coverage/
coverage.xml
*.cover
.hypothesis/
junit*.xml
*.trace
*.har
__snapshots__/
*.snap
cassettes/
*cassette*
fixtures/recorded/
screenshots/
*-acceptance.md
*_acceptance.md
smoke-test-*.md
verify-*.log

# ---------- 4b. 示例/转录目录（红线）----------
# 这类目录最容易沉淀真实运行记录（密钥、账号、真实主机名会顺着示例文件流出）。
# 默认整体屏蔽。若确实要发布「人造数据」的示例目录，显式加白名单并重新检查。
example/
examples/
transcripts/
sample-output/
sample_output/
demo-output/
recordings/

# ---------- 5. 账号 / 基础设施状态（红线）----------
cdk.out/
cdk.context.json
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example
.terraform/
.terraform.lock.hcl
.serverless/
.sam/
samconfig.toml
.chalice/deployed/
inventory.ini
hosts.ini
*.retry

# ---------- 6. 内部 / AI 工具产物 ----------
.kiro/
.claude/
.amazonq/
.cursor/
.aider*
.continue/
CLAUDE.md
AGENTS.md
GEMINI.md
docs/superpowers/
docs/internal/
*-internal.md
holmes-report*.json
HOLMES*.md
ticket*.md
ticket*.png
runbook-snapshot*
midway*
*.quip
*-JUSTIFICATION.md

# ---------- 7. 依赖 / 构建产物 ----------
node_modules/
.pnp.*
.yarn/
jspm_packages/
bower_components/
venv/
.venv/
env/
ENV/
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/
out/
target/
.next/
.nuxt/
.svelte-kit/
.turbo/
.parcel-cache/
.cache/
.vite/
*.tsbuildinfo

# ---------- 8. 大文件 / 二进制 ----------
*.tar
*.tar.*
*.tgz
*.txz
*.zip
*.7z
*.rar
*.iso
*.img
*.dmg
*.jar
*.war
*.so
*.dylib
*.dll
*.bin
