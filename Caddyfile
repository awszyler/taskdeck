# Caddyfile — production reverse proxy + static file server
# PUBLIC_HOSTNAME is injected at runtime via docker-compose environment.
# Caddy auto-provisions TLS via Let's Encrypt when given a real domain name.
# For IP-only setups see the comment at the bottom of this file.

{$PUBLIC_HOSTNAME} {
    # Runner websocket / CRP endpoint
    handle /api/v1/crp/* {
        reverse_proxy core:8000
    }

    # Frontend SSE / websocket push endpoint
    handle /api/v1/ws {
        reverse_proxy core:8000
    }

    # Sandbox proxy (P6.3). Path-prefix routing — see
    # docs/p6.3-decisions.md (D-A5, P-2) for the base-path tradeoff.
    # The whole path is /sandbox/<task_id>/... ; we forward_auth to
    # core's auth-only endpoint (cookie + workspace ACL) before
    # touching sandbox-host.
    @sandbox path_regexp sandbox ^/sandbox/([^/]+)(/.*)?$
    handle @sandbox {
        forward_auth core:8000 {
            uri /api/v1/sandbox/auth/{re.sandbox.1}
            copy_headers Cookie
        }
        reverse_proxy sandbox-host:9101
    }

    # All other API calls
    handle /api/* {
        reverse_proxy core:8000
    }

    # Static SPA — tries the exact path first, falls back to index.html
    handle {
        root * /srv/web
        try_files {path} /index.html
        file_server
    }
}

# ── IP-only / HTTP-only mode ──────────────────────────────────────────────────
# If you don't have a domain and just want plain HTTP on port 80, replace the
# block above with:
#
#   :80 {
#       handle /api/v1/crp/* { reverse_proxy core:8000 }
#       handle /api/v1/ws    { reverse_proxy core:8000 }
#       handle /api/*        { reverse_proxy core:8000 }
#       handle {
#           root * /srv/web
#           try_files {path} /index.html
#           file_server
#       }
#   }
#
# Remember to update TD_CORE_WS_URL (ws://) and TD_PUBLIC_BASE_URL (http://)
# in .env.production accordingly.
