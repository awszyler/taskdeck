# Core
DATABASE_URL=postgresql+asyncpg://taskdeck:taskdeck@localhost:5432/taskdeck
TD_RUNNER_BEARER_TOKEN=dev-runner-token
CORS_ORIGINS=http://localhost:5173
TD_ARTIFACT_DIR=/tmp/taskdeck-artifacts

# Runner
TD_CORE_WS_URL=ws://localhost:8000/api/v1/crp/connect
TD_CORE_HTTP_URL=http://localhost:8000
TD_RUNNER_TOKEN=dev-runner-token
TD_RUNNER_NAME=dev-runner
TD_MAX_PARALLEL=2
TD_WORK_DIR=/tmp/taskdeck-work
# TD_CLAUDE_CODE_BIN=/usr/local/bin/claude

# Intent Parser (optional — system boots without these; Intent Parser falls back gracefully)
# TD_LITELLM_BASE_URL=http://localhost:4000
# TD_LITELLM_API_KEY=sk-...
# TD_INTENT_PARSER_MODEL=anthropic/claude-sonnet-4-6
# TD_INTENT_PARSER_TIMEOUT_SECONDS=5.0
# TD_STT_MODEL=whisper-1
# TD_STT_TIMEOUT_SECONDS=30.0

# Amazon Bedrock AgentCore (P2.3) — optional, disabled by default
# TD_AGENTCORE_ENABLED=true
# TD_AGENTCORE_REGION=ap-northeast-1
# TD_AGENTCORE_AGENT_IDS=agent-foo,agent-bar
# TD_AGENTCORE_AGENT_ALIAS_ID=TSTALIASID

# Auth (P5.1) — disabled by default; all TD_COGNITO_* fields only take effect
# when TD_AUTH_MODE=cognito. See docs/runbook.md §10 for the one-time
# AWS Cognito User Pool setup steps.
# Existing single-user deployments leave this as "disabled" and nothing changes.
TD_AUTH_MODE=disabled
# TD_AUTH_ALLOW_SIGNUP=false                     # gate self-service signup UI + endpoint
# TD_COGNITO_USER_POOL_ID=ap-northeast-1_xxxxx   # required when auth_mode=cognito
# TD_COGNITO_CLIENT_ID=xxxxx                     # public app client (no secret)
# TD_COGNITO_REGION=ap-northeast-1
# TD_SESSION_ENCRYPTION_KEY=                     # Fernet key — see runbook for generator
# TD_SESSION_COOKIE_NAME=ccpt_session
# TD_SESSION_COOKIE_DOMAIN=                      # leave empty for host-only cookie

# Hardening (P4.0)
TD_METRICS_ENABLED=true
TD_RATE_LIMIT_AUTH_PER_MINUTE=30
TD_REQUEST_MAX_BODY_BYTES=26214400   # 25 MB
# Runner metrics
# TD_RUNNER_METRICS_ENABLED=true
# TD_RUNNER_METRICS_PORT=9100

# Memory / RAG (P3.3) — disabled by default; requires LiteLLM or Bedrock configured
TD_MEMORY_ENABLED=false
# TD_MEMORY_EMBEDDING_MODEL=text-embedding-3-small   (LiteLLM path only)
# TD_MEMORY_TOP_K=4
# TD_MEMORY_TOTAL_CAP_BYTES=4096
# TD_MEMORY_PER_CHUNK_CAP_BYTES=1024
# TD_BEDROCK_EMBEDDING_ENABLED=true   (use Bedrock instead of LiteLLM for embeddings)
# TD_BEDROCK_EMBEDDING_MODEL=cohere.embed-multilingual-v3
# TD_BEDROCK_REGION=ap-northeast-1

# WeCom IM (M4) — optional, disabled by default
TD_WECOM_ENABLED=false
# TD_WECOM_CORP_ID=
# TD_WECOM_SECRET=
# TD_WECOM_AGENT_ID=
# TD_WECOM_TOKEN=
# TD_WECOM_AES_KEY=
# TD_WECOM_DEFAULT_WORKSPACE_SLUG=default
# TD_PUBLIC_BASE_URL=http://localhost:8000
